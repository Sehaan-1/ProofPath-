# =============================================================================
# ProofPath Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your local values:
#   cp .env.example .env
#
# NEVER commit `.env` or real API keys/tokens to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Runtime profile: local | test | production
APP_ENV=local

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector & Redis
# -----------------------------------------------------------------------------
# Async SQLAlchemy PostgreSQL connection string (pgvector-enabled database).
# Matches the local Docker Compose PostgreSQL service.
DATABASE_URL=postgresql+asyncpg://proofpath:proofpath@localhost:5432/proofpath

# Redis connection URL for async job queues and background workers.
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM & Embedding Provider
# -----------------------------------------------------------------------------
# Provider identifier: openai | anthropic | gemini | ollama
LLM_PROVIDER=openai

# Default chat/reasoning model used for structured extraction & verification.
LLM_MODEL=gpt-4o-mini

# Provider API key (leave blank here; populate only in your untracked `.env`).
# Required for live LLM/embedding calls and when APP_ENV=production.
LLM_API_KEY=

# Embedding model name and matching pgvector column dimensionality.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# GitHub Evidence Ingestion
# -----------------------------------------------------------------------------
# Optional read-only GitHub Personal Access Token for REST API ingestion
# (leave blank here; populate only in your untracked `.env`).
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Approved-Only Side Effects (Slice 2.1.3)
# -----------------------------------------------------------------------------
# Explicit opt-in for LIVE Google Calendar writes after a human approves a
# calendar_block draft. Keep false (default): ProofPath then only writes the local
# calendar task and serves a downloadable .ics invite, with no network call at all.
ENABLE_GOOGLE_CALENDAR=false

# Target Google Calendar id (for example "primary"); required when opted in.
GOOGLE_CALENDAR_ID=

# OAuth access token for the Calendar API import call; required when opted in
# (leave blank here; populate only in your untracked `.env`).
GOOGLE_CALENDAR_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Agent Safety, Guardrails & Observability
# -----------------------------------------------------------------------------
# Observability backend (pick at most one): none | langfuse | openllmetry
OBSERVABILITY_BACKEND=none

# Hard upper bound on LangGraph policy/tool retry loops (allowed: 0..5).
MAX_AGENT_RETRIES=2

# Also apply Guardrails AI locally to final output (requires the guardrails extra).
# The built-in citation/trace checks are always on. Rebuild the worker after toggling.
ENABLE_GUARDRAILS=false

# Mask personal phone numbers/addresses before sending prompts to external LLMs.
REDACT_PII=false

# -----------------------------------------------------------------------------
# Background Worker Retry & Dead-Letter Policy (Slice 2.2.3)
# -----------------------------------------------------------------------------
# Maximum processing attempts for a transiently-failing background job (1..10)
# before it is pushed to the dead-letter state. Validation/permanent errors fail
# fast to dead_letter on the first attempt regardless of this value.
JOB_MAX_ATTEMPTS=3

# Exponential backoff delays (seconds) before re-enqueuing a transiently-failed
# job, indexed by the failed attempt number. Parsed as a JSON array.
# Default: 2s -> 8s -> 30s (e.g. attempt 1 fails -> wait 2s -> attempt 2).
JOB_RETRY_BACKOFF_SECONDS=[2, 8, 30]
